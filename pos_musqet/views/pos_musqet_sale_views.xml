<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_musqet_sale_view_list" model="ir.ui.view">
        <field name="name">pos.musqet.sale.list</field>
        <field name="model">pos.musqet.sale</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date" string="Started"/>
                <field name="reference"/>
                <field name="sale_id"/>
                <field name="amount_minor"/>
                <field name="currency"/>
                <field name="rail"/>
                <field name="payment_method_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="not_found_at" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="pos_musqet_sale_view_form" model="ir.ui.view">
        <field name="name">pos.musqet.sale.form</field>
        <field name="model">pos.musqet.sale</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="sale_id"/>
                            <field name="rail"/>
                        </group>
                        <group>
                            <field name="amount_minor"/>
                            <field name="currency"/>
                            <field name="payment_method_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="not_found_at" invisible="not not_found_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_musqet_sale" model="ir.actions.act_window">
        <field name="name">Musqet Sales</field>
        <field name="res_model">pos.musqet.sale</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pos_musqet_sale"
              name="Musqet Sales"
              parent="point_of_sale.menu_point_of_sale"
              action="action_pos_musqet_sale"
              groups="point_of_sale.group_pos_manager"
              sequence="89"/>
</odoo>
